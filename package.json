{
  "name": "flowleaf-66day",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-content.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-content.mjs",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "pretypecheck": "node scripts/build-content.mjs --quiet",
    "typecheck": "tsc -b --noEmit",
    "pretest": "node scripts/build-content.mjs --quiet",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check --strict",
    "content:watch": "node --watch-path=content --watch-preserve-output scripts/build-content.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "yaml": "^2.9.1"
  }
}
