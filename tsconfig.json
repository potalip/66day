{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "paths": { "@web/*": ["./web/src/*"], "@shared/*": ["./shared/*"], "@content/*": ["./content/*"] }
  },
  "include": ["web/src", "worker", "shared", "scripts", "vite.config.ts"]
}
