{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowleaf-66day",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  // D1 — all relational data. Migrations in /migrations (each agent owns its own numbered file).
  "d1_databases": [{ "binding": "DB", "database_name": "flowleaf-66day", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  // R2 — uploaded videos, transcripts, generated media.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "flowleaf-66day-media" }],
  // Queue — resource pipeline + studio jobs run async.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "flowleaf-66day-jobs" }],
    "consumers": [{ "queue": "flowleaf-66day-jobs", "max_batch_size": 5, "max_retries": 3 }]
  },
  "vars": {
    "APP_ENV": "dev",
    "CLAUDE_MODEL": "claude-sonnet-5-5",
    "CLAUDE_MODEL_SMART": "claude-opus-5-5",
    "RENDER_SERVER_URL": ""
  }
  // Secrets (wrangler secret put / .dev.vars): ANTHROPIC_API_KEY, RENDER_SERVER_TOKEN, ADMIN_TOKEN
}
